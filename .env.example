# GuardianAI environment example. Copy to .env and fill in.
# Every value is optional — the stack falls back gracefully when keys are unset
# (LLM judge returns neutral verdicts; HF endpoints use unauthenticated rate limits).

# --- LLM providers (used by the agents, the proxy upstreams, and the SDK) ---
# Used by: backend/src/guardian/llm_judge.py, backend/src/proxy/upstream.py
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- HuggingFace (optional, lifts unauthenticated rate limits on model downloads) ---
HF_TOKEN=

# --- Backend service ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
GUARDIAN_BACKEND_URL=http://localhost:8000

# --- Proxy service (Phase 6) ---
PROXY_PORT=8001

# --- Frontend public env (Vite reads VITE_*) ---
VITE_API_BASE=http://localhost:8000

# --- Domain (medical | legal | financial | open) ---
GUARDIAN_DOMAIN=medical
